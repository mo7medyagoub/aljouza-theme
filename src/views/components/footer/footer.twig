<footer class="store-footer">
  <div class="footer-bento-wrapper">
    <div aria-label="footer" class="footer-glass-card">
      {# Bento Grid Inner Layout #}
      <div class="footer-bento-grid">

        {# Cell 1: Brand + Description #}
        <div class="footer-bento-cell footer-bento-brand">
          <a href="{{ link('/') }}" class="flex items-center m-0 mb-4">
            <h3 class="!mb-0">{{store.name}}</h3>
          </a>
          {% if store.description %}
            <div class="max-w-sm leading-7 mb-6 opacity-80 text-sm">
              {{ store.description|raw }}
            </div>
          {% endif %}

          <div class="hidden lg:block">
            <salla-social class="block mb-6"></salla-social>
          </div>

          <div class="flex gap-4 flex-wrap">
            {# trust badges #}
            <salla-trust-badges {% if theme.settings.get('footer_is_dark') %} dark {% endif %}></salla-trust-badges>
            {# vat #}
            {% if store.settings.tax.number %}
              <div class="flex rtl:space-x-reverse space-x-2 items-end">
                {% if store.settings.tax.certificate %}
                  <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                    <img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-10 rounded-sm hover:opacity-80 transition-opacity" alt="value added tax">
                  </a>
                {% endif %}
                <div>
                  <p class="text-sm mb-1 opacity-70">{{ trans('common.elements.tax_number') }}</p>
                  <b class="text-sm">{{ store.settings.tax.number }}</b>
                </div>
              </div>

              {% if store.settings.tax.certificate %}
                <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                  <div class="flex justify-center max-w-full">
                    <img class="w-full" loading="lazy"
                    data-src="{{ store.settings.tax.certificate }}"
                    alt="{{ store.settings.tax.number }}"/>
                  </div>
                </salla-modal>
              {% endif %}
            {% endif %}
          </div>
        </div>

        {# Cell 2: Pages Links #}
        <div class="footer-bento-cell footer-bento-links">
          <h3>{{ trans('blocks.footer.pages_links') }}</h3>
          <salla-menu source="footer" with-cookie-preferences></salla-menu>
        </div>

        {# Cell 3: Contacts + Social #}
        <div class="footer-bento-cell footer-bento-contacts">
          <salla-contacts></salla-contacts>

          <div class="lg:hidden contact-social">
            <salla-social></salla-social>
          </div>
        </div>

        {# Cell 4: Apps Icons #}
        <div class="footer-bento-cell footer-bento-apps">
          <salla-apps-icons></salla-apps-icons>
        </div>

      </div>

      {# Copyright Bar #}
      <div class="footer-copyright-bar">
        <span class="text-sm copyright-text opacity-70">{% hook copyright %}</span>
        <salla-payments></salla-payments>
      </div>
    </div>
  </div>

<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span></footer>

